---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="jacket">
  <div class="container jacket__inner">
    <a href="/self-improvement-field-guide/" class="jacket__mark">
      <span class="jacket__name">The Field Guide</span>
      <span class="jacket__sub">evidence-graded · practice-first</span>
    </a>
    <div class="jacket__right">
      <nav aria-label="Primary">
        <ul class="jacket__nav">
          {site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[{ active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" class="jacket__search" data-search-open aria-label="Search the guide (press /)">
        search <kbd>/</kbd>
      </button>
      <button type="button" class="jacket__theme" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="ico-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
        <svg class="ico-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .jacket {
    background: var(--jacket);
    color: var(--paper);
  }
  .jacket__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.3rem 1.1rem;
  }
  .jacket__mark {
    text-decoration: none;
    color: var(--jacket-ink);
  }
  .jacket__name {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
    font-size: 1.7rem;
    line-height: 1;
  }
  .jacket__sub {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(241, 239, 227, 0.55);
    margin-top: 0.35rem;
  }
  .jacket__right {
    display: flex;
    align-items: center;
    gap: 1.3rem;
  }
  .jacket__search {
    font-family: var(--font-body);
    font-size: 0.76rem;
    color: rgba(241, 239, 227, 0.75);
    background: rgba(241, 239, 227, 0.08);
    border: 1px solid rgba(241, 239, 227, 0.3);
    padding: 0.34rem 0.62rem;
    cursor: pointer;
  }
  .jacket__search:hover {
    color: var(--paper);
    border-color: rgba(241, 239, 227, 0.6);
  }
  .jacket__search kbd {
    font-family: inherit;
    font-size: 0.68rem;
  }
  .jacket__theme {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    color: rgba(241, 239, 227, 0.75);
    background: rgba(241, 239, 227, 0.08);
    border: 1px solid rgba(241, 239, 227, 0.3);
    cursor: pointer;
    padding: 0;
  }
  .jacket__theme:hover {
    color: var(--jacket-ink);
    border-color: rgba(241, 239, 227, 0.6);
  }
  .jacket__theme .ico-sun {
    display: none;
  }
  .jacket__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }
  .jacket__nav a {
    color: rgba(241, 239, 227, 0.75);
    text-decoration: none;
    padding-block: 0.2rem;
    border-bottom: 2px solid transparent;
  }
  .jacket__nav a:hover {
    color: var(--jacket-ink);
  }
  .jacket__nav a.active {
    color: var(--jacket-ink);
    border-bottom-color: #9ec48f;
  }
</style>
