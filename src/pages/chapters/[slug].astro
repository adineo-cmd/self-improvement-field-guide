---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import tabs from '../../data/tabs.json';

export function getStaticPaths() {
  return tabs.map((t: any) => ({ params: { slug: t.slug }, props: { tab: t } }));
}

const { tab } = Astro.props;

function chapterName(t: any) {
  return t.sheet
    .toLowerCase()
    .split(' ')
    .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}
function anchor(title: string, num: number) {
  const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return `g-${slug || 'general'}-${num}`;
}
const name = chapterName(tab);
const idx = tabs.indexOf(tab);
const prev = tabs[idx - 1];
const next = tabs[idx + 1];

// group entries by their section divider
const groups: { title: string; entries: any[] }[] = [];
for (const e of tab.entries) {
  const g = groups[groups.length - 1];
  if (!g || g.title !== e.section) {
    groups.push({ title: e.section, entries: [e] });
  } else {
    g.entries.push(e);
  }
}

// neighbours within a section, for the "related" row under each entry
function neighbours(section: any[], num: number) {
  const i = section.findIndex((x) => x.num === num);
  return { prev: i > 0 ? section[i - 1] : undefined, next: i < section.length - 1 ? section[i + 1] : undefined };
}

// "start here": the best-evidence entries to read first
const rank: Record<string, number> = { Strong: 0, Moderate: 1, Mixed: 2, Emerging: 3 };
const startHere = [...tab.entries]
  .filter((e) => e.strength && rank[e.strength] !== undefined)
  .sort((a, b) => (rank[a.strength] ?? 9) - (rank[b.strength] ?? 9))
  .slice(0, 3);
---

<Base title={name} description={tab.description}>
  <div class="container chapter">
    <header class="chapter__head">
      <p class="chapter__crumb">
        <a href="/chapters">Chapters</a>
        <span aria-hidden="true"> / </span>
        <span class="mono">{String(idx + 1).padStart(2, '0')}</span>
      </p>
      <h1>{name}</h1>
      <p class="chapter__desc measure">{tab.description}</p>
      {tab.hint && <p class="chapter__hint">{tab.hint}</p>}
      <div class="chapter__bar">
        <nav class="chapter__sections" aria-label="Sections in this chapter">
          {groups.map((g) => (
            <a href={`#${anchor(g.title, g.entries[0].num)}`}>{g.title || 'General'}</a>
          ))}
        </nav>
        <div class="filter" role="group" aria-label="Filter entries by evidence strength">
          <span class="filter__label">evidence</span>
          {['Strong', 'Moderate', 'Mixed', 'Emerging', 'Myth'].map((s) => (
            <button type="button" class="filter__btn" data-filter={s}>{s}</button>
          ))}
          <button type="button" class="filter__btn filter__btn--clear" data-filter-clear hidden>show all</button>
        </div>
      </div>
    </header>

    {startHere.length > 0 && (
      <aside class="starthere" aria-labelledby="starthere-h">
        <p class="starthere__label" id="starthere-h">Start here — the best-evidence entries in this chapter</p>
        <ol class="starthere__list">
          {startHere.map((e: any) => (
            <li>
              <a href={`#e${e.num}`}>
                <span class="starthere__num">{String(e.num).padStart(3, '0')}</span>
                <span class="starthere__title">{e.title}</span>
                <span class="starthere__strength">{e.strength}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}

    {groups.map((g) => (
      <section class="group" id={anchor(g.title, g.entries[0].num)}>
        {g.title && <h2 class="group__title">{g.title}</h2>}
        <div class="group__entries">
          {g.entries.map((e: any) => {
            const rel = neighbours(g.entries, e.num);
            return (
              <div class="entrywrap">
                <Entry entry={e} kind={tab.kind} />
                {(rel.prev || rel.next) && (
                  <p class="entrywrap__related">
                    {rel.prev && <a href={`#e${rel.prev.num}`} rel="prev">← {rel.prev.title}</a>}
                    {rel.next && <a href={`#e${rel.next.num}`} rel="next">{rel.next.title} →</a>}
                  </p>
                )}
              </div>
            );
          })}
        </div>
        <p class="group__empty" hidden data-empty-note>
          No {tab.kind === 'scenario' ? 'playbooks' : 'entries'} in this section carry that label.
        </p>
      </section>
    ))}

    <nav class="pager" aria-label="Chapters">
      {prev && <a href={`/chapters/${prev.slug}`} rel="prev">← {chapterName(prev)}</a>}
      <a href="/chapters" rel="index">All chapters</a>
      {next && <a href={`/chapters/${next.slug}`} rel="next">{chapterName(next)} →</a>}
    </nav>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-filter-clear]');
  let active: string | null = null;

  function apply() {
    document.querySelectorAll<HTMLElement>('.entry[data-strength]').forEach((el) => {
      const show = !active || el.dataset.strength === active;
      el.classList.toggle('is-hidden', !show);
    });
    document.querySelectorAll<HTMLElement>('.group').forEach((g) => {
      const note = g.querySelector<HTMLElement>('[data-empty-note]');
      const visible = g.querySelectorAll('.entry:not(.is-hidden)').length;
      if (note) note.hidden = visible > 0;
    });
    buttons.forEach((b) => b.classList.toggle('is-on', b.dataset.filter === active));
    if (clearBtn) clearBtn.hidden = !active;
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      active = active === b.dataset.filter ? null : (b.dataset.filter ?? null);
      apply();
    })
  );
  clearBtn?.addEventListener('click', () => {
    active = null;
    apply();
  });
</script>

<style>
  .chapter {
    padding-block: 3rem 1rem;
  }
  .chapter__crumb {
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }
  .chapter__crumb a {
    color: var(--ink-soft);
  }
  .chapter h1 {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    margin-bottom: 0.7rem;
  }
  .chapter__desc {
    color: var(--ink-soft);
    font-size: 1.08rem;
  }
  .chapter__hint {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  .chapter__bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    padding-block: 0.7rem;
    border-block: 1px solid var(--line);
  }
  .chapter__sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    font-size: 0.85rem;
  }
  .chapter__sections a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .chapter__sections a:hover {
    color: var(--moss);
  }
  .filter {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .filter__label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-right: 0.2rem;
  }
  .filter__btn {
    font-family: var(--font-body);
    font-size: 0.74rem;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--line-strong);
    padding: 0.22rem 0.55rem;
    cursor: pointer;
  }
  .filter__btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .filter__btn.is-on {
    color: var(--moss-deep);
    border-color: var(--moss);
    background: color-mix(in srgb, var(--moss) 10%, transparent);
  }
  .group__empty {
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-style: italic;
  }
  .chapter :global(.entry.is-hidden) {
    display: none;
  }
  .group {
    margin-top: 2.6rem;
    scroll-margin-top: 4rem;
  }
  .starthere {
    margin-top: 1.8rem;
    background: var(--jacket);
    color: var(--paper);
    padding: 1.2rem 1.4rem 1.3rem;
  }
  .starthere__label {
    font-size: 0.7rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(241, 239, 227, 0.6);
    margin-bottom: 0.8rem;
  }
  .starthere__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .starthere__list a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--paper);
  }
  .starthere__list a:hover .starthere__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .starthere__num {
    font-size: 0.72rem;
    color: #9ec48f;
    min-width: 2.2rem;
  }
  .starthere__title {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
    font-size: 1.1rem;
  }
  .starthere__strength {
    margin-left: auto;
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(241, 239, 227, 0.55);
    white-space: nowrap;
  }
  .entrywrap__related {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: -0.4rem 0 0.9rem;
    padding-inline: 0.2rem;
    font-size: 0.8rem;
  }
  .entrywrap__related a {
    color: var(--ink-soft);
    text-decoration: none;
    max-width: 45%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .entrywrap__related a:hover {
    color: var(--moss);
  }
  .entrywrap__related a:last-child {
    text-align: right;
  }
  .group__title {
    font-size: 1.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: 1.2rem;
  }
  .group__entries {
    display: grid;
    gap: 1.1rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line-strong);
    font-size: 0.92rem;
  }
  .pager a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--moss);
  }
</style>
