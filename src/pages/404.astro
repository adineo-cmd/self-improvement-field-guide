---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <div class="container lost">
    <p class="lost__code">404</p>
    <h1>Off the trail.</h1>
    <p class="lost__text">That page is not in the guide. The contents page is the fastest way back.</p>
    <p><a href="/">Back to the contents</a></p>
  </div>
</Base>

<style>
  .lost {
    padding-block: 6rem;
  }
  .lost__code {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-bottom: 0.8rem;
  }
  .lost__text {
    color: var(--ink-soft);
    margin-bottom: 1.4rem;
  }
</style>
