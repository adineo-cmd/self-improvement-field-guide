<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-panel">
    <div class="search-head">
      <h2 id="search-title" class="sr-only">Search the guide</h2>
      <input
        type="search"
        class="search-input"
        placeholder="Search 599 entries…"
        autocomplete="off"
        spellcheck="false"
        data-search-input
        aria-controls="search-results"
        aria-describedby="search-hint"
      />
      <button type="button" class="search-close" data-search-close aria-label="Close search">
        <kbd>esc</kbd>
      </button>
    </div>

    <div class="search-body">
      <p class="search-label" data-search-label>Start here</p>
      <div class="search-results" id="search-results" data-search-results role="listbox" aria-label="Search results"></div>
      <p class="search-empty" data-search-empty hidden>
        Nothing found for “<span data-search-query></span>”. Try a broader word — “eye contact”,
        “apologise”, “first date” — or <a href="/">go back to the contents</a>.
      </p>
    </div>

    <div class="search-foot" id="search-hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
      <span><kbd>↵</kbd> to open</span>
      <span class="search-foot__brand">The Field Guide</span>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(100% - 1.5rem, 720px);
    max-width: none;
    max-height: min(84vh, 720px);
    margin: 8vh auto auto;
    padding: 0;
    background: var(--panel);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgba(24, 33, 28, 0.5);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: min(84vh, 720px);
  }
  .search-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 1.02rem;
    color: var(--ink);
  }
  .search-input::placeholder {
    color: var(--ink-soft);
    opacity: 0.7;
  }
  .search-close {
    color: var(--ink-soft);
    background: none;
    border: 0;
    padding: 0.2rem;
    cursor: pointer;
  }
  .search-close kbd {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.14rem 0.34rem;
    border: 1px solid var(--line-strong);
  }
  .search-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.9rem 0.6rem 1.1rem;
    overscroll-behavior: contain;
  }
  .search-label {
    padding: 0.2rem 0.65rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .search-results {
    display: flex;
    flex-direction: column;
  }
  .search-empty {
    padding: 1.4rem 0.65rem 1.8rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    max-width: 48ch;
  }
  .search-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 1.1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-soft);
  }
  .search-foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .search-foot__brand {
    margin-left: auto;
  }
  .search-foot kbd {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    padding: 0 0.22rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }
  :global(.search-result) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.75rem;
    padding: 0.65rem 0.7rem;
    text-decoration: none;
    color: var(--ink);
    border-left: 2px solid transparent;
  }
  :global(.search-result:hover),
  :global(.search-result.is-active) {
    background: var(--paper);
    border-left-color: var(--moss);
  }
  :global(.search-result__kind) {
    grid-row: span 2;
    align-self: start;
    margin-top: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--moss);
    min-width: 4.4rem;
  }
  :global(.search-result__title) {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  :global(.search-result__desc) {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--ink-soft);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
</style>

<script>
  type SearchDoc = {
    kind: string;
    title: string;
    description: string;
    url: string;
    keywords?: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const resultsEl = document.querySelector<HTMLElement>('[data-search-results]');
  const emptyEl = document.querySelector<HTMLElement>('[data-search-empty]');
  const queryEl = document.querySelector<HTMLElement>('[data-search-query]');
  const labelEl = document.querySelector<HTMLElement>('[data-search-label]');

  let docs: SearchDoc[] = [];
  let loaded = false;
  let loading: Promise<void> | null = null;
  let activeIndex = -1;
  let currentResults: SearchDoc[] = [];

  async function loadDocs() {
    if (loaded) return;
    if (loading) return loading;
    loading = fetch('/search.json')
      .then((res) => res.json())
      .then((data: { documents: SearchDoc[] }) => {
        docs = data.documents;
        loaded = true;
      })
      .catch(() => {
        docs = [];
        loaded = true;
      });
    return loading;
  }

  function score(doc: SearchDoc, terms: string[]) {
    const title = doc.title.toLowerCase();
    const description = doc.description.toLowerCase();
    const keywords = (doc.keywords ?? '').toLowerCase();
    let total = 0;
    for (const term of terms) {
      if (title.startsWith(term)) total += 8;
      else if (title.includes(term)) total += 5;
      if (keywords.includes(term)) total += 3;
      if (description.includes(term)) total += 2;
      if (!title.includes(term) && !keywords.includes(term) && !description.includes(term)) return 0;
    }
    return total;
  }

  function render(doc: SearchDoc, index: number) {
    const active = index === activeIndex ? ' is-active' : '';
    return `<a class="search-result${active}" href="${doc.url}" role="option" aria-selected="${index === activeIndex}">
      <span class="search-result__kind">${doc.kind}</span>
      <span class="search-result__title">${doc.title}</span>
      <span class="search-result__desc">${doc.description}</span>
    </a>`;
  }

  function showResults(query: string) {
    if (!resultsEl || !emptyEl || !labelEl || !queryEl) return;
    const clean = query.trim().toLowerCase();

    if (!clean) {
      currentResults = docs.filter((d) => d.kind !== 'Row').slice(0, 6);
      labelEl.textContent = 'Start here';
      emptyEl.hidden = true;
    } else {
      const terms = clean.split(/\s+/).filter(Boolean);
      currentResults = docs
        .map((doc) => ({ doc, s: score(doc, terms) }))
        .filter((item) => item.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 9)
        .map((item) => item.doc);
      labelEl.textContent = currentResults.length
        ? `${currentResults.length} result${currentResults.length === 1 ? '' : 's'}`
        : 'No matches';
      emptyEl.hidden = currentResults.length > 0;
      queryEl.textContent = query.trim();
    }

    activeIndex = currentResults.length ? 0 : -1;
    resultsEl.innerHTML = currentResults.map(render).join('');
  }

  function move(delta: number) {
    if (!currentResults.length || !resultsEl) return;
    activeIndex = (activeIndex + delta + currentResults.length) % currentResults.length;
    resultsEl.querySelectorAll<HTMLElement>('.search-result').forEach((el, i) => {
      el.classList.toggle('is-active', i === activeIndex);
      el.setAttribute('aria-selected', String(i === activeIndex));
    });
    resultsEl.children[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (!dialog) return;
    dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
    loadDocs().then(() => {
      if (input && !input.value) showResults('');
      input?.focus();
    });
  }

  function close() {
    dialog?.close();
  }

  document.querySelectorAll('[data-search-open]').forEach((btn) => {
    btn.addEventListener('click', open);
  });

  document.querySelector('[data-search-close]')?.addEventListener('click', close);

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    if (input) input.value = '';
    activeIndex = -1;
  });

  input?.addEventListener('input', () => showResults(input.value));

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      const target = currentResults[activeIndex];
      if (target) {
        event.preventDefault();
        window.location.href = target.url;
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable;

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) close();
      else open();
    }

    if (event.key === '/' && !typing && !dialog?.open) {
      event.preventDefault();
      open();
    }
  });
</script>
